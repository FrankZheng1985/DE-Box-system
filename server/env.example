# 服务器配置
PORT=3002
NODE_ENV=development

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/germany_box_transport

# JWT 配置
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# CORS 配置
# 支持逗号分隔多个来源（域名迁移期间正式域名和 IP 直访要同时可用）
# 生产示例：https://kalunasped.com,https://www.kalunasped.com,https://47.83.241.117
CORS_ORIGIN=http://localhost:5174

# 系统对外访问地址（报价确认邮件里的链接用，必须是客户能打开的绝对地址）
# 只能有一个值；不配则退回 CORS_ORIGIN 的第一个。生产为 https://kalunasped.com
APP_BASE_URL=http://localhost:5174

# ============================================================
# SMTP 邮件配置
# 缺少 SMTP_USER / SMTP_PASS 时系统不会发信，
# 通知会留在 notifications 表里（email_status=PENDING），配好后自动补发。
# ⚠️ 改完 .env 必须 pm2 delete all 再 pm2 start，只 restart 不生效（踩坑 005）
# ============================================================
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@kalunasped.com
SMTP_PASS=your-smtp-password
SMTP_FROM=info@kalunasped.com

# 官网留言的通知收件人（不填默认 info@box-cargo.de）
ADMIN_EMAIL=info@kalunasped.com

# ============================================================
# 阿里云 OSS 文件存储
# 四个变量缺任意一个都会退回本地 uploads/ 目录存储
# ============================================================
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=box-cargo-files
OSS_REGION=oss-cn-hongkong
