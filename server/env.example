# 服务器配置
PORT=3002
NODE_ENV=development

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/germany_box_transport

# JWT 配置
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# CORS 配置
CORS_ORIGIN=http://localhost:5174

# ============================================================
# SMTP 邮件配置
# 缺少 SMTP_USER / SMTP_PASS 时系统不会发信，
# 通知会留在 notifications 表里（email_status=PENDING），配好后自动补发。
# ⚠️ 改完 .env 必须 pm2 delete all 再 pm2 start，只 restart 不生效（踩坑 005）
# ============================================================
SMTP_HOST=smtp.strato.de
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@box-cargo.de
SMTP_PASS=your-smtp-password
SMTP_FROM=info@box-cargo.de

# 官网留言的通知收件人（不填默认 info@box-cargo.de）
ADMIN_EMAIL=info@box-cargo.de

# ============================================================
# 阿里云 OSS 文件存储
# 四个变量缺任意一个都会退回本地 uploads/ 目录存储
# ============================================================
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=box-cargo-files
OSS_REGION=oss-cn-hongkong
